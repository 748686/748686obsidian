name: 748686 FEISHU E2E CALLBACK TEST V5.0

on:
  workflow_dispatch:

jobs:
  feishu-e2e:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Feishu SDK
        run: |
          python -m pip install --upgrade pip
          pip install -U lark-oapi

      - name: Run E2E Callback Test
        env:
          LARK_APP_ID: ${{ secrets.APP_ID }}
          LARK_APP_SECRET: ${{ secrets.APP_SECRET }}
        run: |
          python <<'PY'
          import json
          import time
          import lark_oapi as lark
          from lark_oapi.event.callback.model.p2_card_action_trigger import P2CardActionTriggerResponse


          # ============================================================
          # 748686 FEISHU E2E CALLBACK TEST V5.0
          #
          # 目的：
          #   飞书 → card.action.trigger
          #   → GitHub WebSocket
          #   → 真实判题
          #   → callback
          #   → 飞书显示正确/错误
          #
          # 本测试：
          #   不使用正式 Parser
          #   不使用正式 Grader
          #   不修改正式考试
          # ============================================================


          print("=" * 70)
          print("748686 FEISHU E2E CALLBACK TEST V5.0")
          print("=" * 70)
          print("MODE:")
          print("  REAL-TIME JUDGING TEST")
          print()
          print("FLOW:")
          print("  Feishu")
          print("    ↓")
          print("  card.action.trigger")
          print("    ↓")
          print("  GitHub WebSocket")
          print("    ↓")
          print("  question_id + answer")
          print("    ↓")
          print("  REAL JUDGING")
          print("    ↓")
          print("  callback response")
          print("    ↓")
          print("  Feishu feedback")
          print("=" * 70)


          # ============================================================
          # 测试题
          # ============================================================

          QUESTIONS = {
              "e2e_test_001": {
                  "number": 1,
                  "question": "1 + 1 = ?",
                  "options": {
                      "A": "1",
                      "B": "2",
                      "C": "3",
                  },
                  "correct": "B",
              },

              "e2e_test_002": {
                  "number": 2,
                  "question": "2 + 3 = ?",
                  "options": {
                      "A": "4",
                      "B": "5",
                      "C": "6",
                  },
                  "correct": "B",
              },

              "e2e_test_003": {
                  "number": 3,
                  "question": "5 - 2 = ?",
                  "options": {
                      "A": "2",
                      "B": "3",
                      "C": "4",
                  },
                  "correct": "B",
              },
          }


          # ============================================================
          # 状态
          # ============================================================

          answers = {}
          score = 0


          # ============================================================
          # 打印测试题
          # ============================================================

          print()
          print("=" * 70)
          print("TEST QUESTIONS")
          print("=" * 70)

          for qid, q in QUESTIONS.items():
              print()
              print(f"第 {q['number']} 题")
              print(q["question"])

              for letter, text in q["options"].items():
                  print(f"{letter}. {text}")

              print(f"正确答案: {q['correct']}")


          # ============================================================
          # 卡片回传处理
          # ============================================================

          def do_card_action_trigger(data):
              global score

              print()
              print("=" * 70)
              print("CARD ACTION RECEIVED")
              print("=" * 70)

              try:
                  # ----------------------------------------------------
                  # 打印安全的事件信息
                  # ----------------------------------------------------

                  event = data.event

                  action = event.action

                  value = action.value or {}

                  question_id = value.get("question_id")
                  answer = value.get("answer")

                  print(f"question_id = {question_id}")
                  print(f"answer      = {answer}")

                  # ----------------------------------------------------
                  # 基础校验
                  # ----------------------------------------------------

                  if not question_id:
                      print("ERROR: missing question_id")

                      return P2CardActionTriggerResponse({
                          "toast": {
                              "type": "error",
                              "content": "❌ 缺少题目 ID"
                          }
                      })

                  if not answer:
                      print("ERROR: missing answer")

                      return P2CardActionTriggerResponse({
                          "toast": {
                              "type": "error",
                              "content": "❌ 缺少答案"
                          }
                      })

                  answer = str(answer).strip().upper()

                  # ----------------------------------------------------
                  # 检查题目
                  # ----------------------------------------------------

                  if question_id not in QUESTIONS:
                      print("ERROR: unknown question")

                      return P2CardActionTriggerResponse({
                          "toast": {
                              "type": "error",
                              "content": "❌ 未知题目"
                          }
                      })

                  question = QUESTIONS[question_id]

                  # ----------------------------------------------------
                  # 防止重复提交
                  # ----------------------------------------------------

                  if question_id in answers:
                      old_answer = answers[question_id]

                      print(
                          f"Duplicate answer ignored: "
                          f"{question_id} = {old_answer}"
                      )

                      return P2CardActionTriggerResponse({
                          "toast": {
                              "type": "warning",
                              "content": "⚠️ 这道题已经回答过了"
                          }
                      })

                  # ----------------------------------------------------
                  # 保存答案
                  # ----------------------------------------------------

                  answers[question_id] = answer

                  # ----------------------------------------------------
                  # REAL JUDGING
                  # ----------------------------------------------------

                  correct_answer = question["correct"]

                  is_correct = answer == correct_answer

                  if is_correct:
                      score += 1

                      print("RESULT = CORRECT")
                      print(f"score = {score}")

                      feedback = (
                          f"✅ 第{question['number']}题回答正确"
                      )

                      toast_type = "success"

                  else:

                      print("RESULT = WRONG")
                      print(f"correct = {correct_answer}")
                      print(f"score = {score}")

                      feedback = (
                          f"❌ 第{question['number']}题回答错误"
                          f"　正确答案：{correct_answer}"
                      )

                      toast_type = "error"

                  # ----------------------------------------------------
                  # 是否全部完成
                  # ----------------------------------------------------

                  completed = len(answers)
                  total = len(QUESTIONS)

                  print(f"completed = {completed}/{total}")

                  # ----------------------------------------------------
                  # 最后一题
                  # ----------------------------------------------------

                  if completed == total:

                      percentage = round(
                          score / total * 100
                      )

                      final_message = (
                          f"{feedback}\n"
                          f"🎉 答题完成！\n"
                          f"得分：{score}/{total}（{percentage}%）"
                      )

                      print()
                      print("=" * 70)
                      print("E2E TEST COMPLETE")
                      print("=" * 70)
                      print(f"Score: {score}/{total}")
                      print(f"Percentage: {percentage}%")
                      print("=" * 70)

                      return P2CardActionTriggerResponse({
                          "toast": {
                              "type": toast_type,
                              "content": final_message
                          }
                      })

                  # ----------------------------------------------------
                  # 普通题目
                  # ----------------------------------------------------

                  progress_message = (
                      f"{feedback}\n"
                      f"当前进度：{completed}/{total}"
                  )

                  return P2CardActionTriggerResponse({
                      "toast": {
                          "type": toast_type,
                          "content": progress_message
                      }
                  })

              except Exception as e:

                  print()
                  print("=" * 70)
                  print("CALLBACK ERROR")
                  print("=" * 70)
                  print(repr(e))
                  print("=" * 70)

                  return P2CardActionTriggerResponse({
                      "toast": {
                          "type": "error",
                          "content": "❌ GitHub 判题发生错误"
                      }
                  })


          # ============================================================
          # WebSocket Client
          # ============================================================

          print()
          print("=" * 70)
          print("EVENT HANDLER READY")
          print("=" * 70)

          event_handler = (
              lark.EventDispatcherHandler.builder(
                  "",
                  "",
                  lark.LogLevel.DEBUG,
              )
              .register_p2_card_action_trigger(
                  do_card_action_trigger
              )
              .build()
          )

          print("✓ card.action.trigger registered")
          print("✓ REAL JUDGING enabled")
          print("✓ CALLBACK RESPONSE enabled")


          # ============================================================
          # WebSocket
          # ============================================================

          print()
          print("=" * 70)
          print("STARTING FEISHU WEBSOCKET")
          print("=" * 70)

          app_id = "${LARK_APP_ID}"
          app_secret = "${LARK_APP_SECRET}"

          # GitHub Actions env 在 Python heredoc 中不能直接通过
          # ${...} 安全读取，所以重新从 os.environ 获取。
          import os

          app_id = os.environ.get("LARK_APP_ID")
          app_secret = os.environ.get("LARK_APP_SECRET")

          if not app_id:
              raise RuntimeError("LARK_APP_ID is missing")

          if not app_secret:
              raise RuntimeError("LARK_APP_SECRET is missing")

          print("APP_ID: ***")
          print("APP_SECRET: loaded")

          print()
          print("Waiting for Feishu answers...")
          print()
          print("IMPORTANT:")
          print("1. Keep this GitHub Action running.")
          print("2. Open the 3 test cards in Feishu.")
          print("3. Click the answers.")
          print("4. Watch both GitHub and Feishu.")
          print()


          cli = lark.ws.Client(
              app_id,
              app_secret,
              event_handler=event_handler,
              log_level=lark.LogLevel.DEBUG,
          )

          print("Connecting...")
          cli.start()
          PY

name: 飞书日报周报带图版测试

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  send-feishu-image-reports:
    runs-on: ubuntu-latest

    steps:

      # ================================================================
      # STEP 1
      # Checkout
      # ================================================================
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1
          lfs: true

      # ================================================================
      # STEP 2
      # 检查 Secrets
      # ================================================================
      - name: 检查飞书 Secrets
        shell: bash
        env:
          FEISHU_WEBHOOK: ${{ secrets.FEISHU_WEBHOOK }}
          APP_ID: ${{ secrets.APP_ID }}
          APP_SECRET: ${{ secrets.APP_SECRET }}
        run: |
          set -e

          echo "=================================================="
          echo "检查飞书 Secrets"
          echo "=================================================="

          if [ -z "$FEISHU_WEBHOOK" ]; then
            echo "❌ FEISHU_WEBHOOK 未设置"
            exit 1
          fi

          if [ -z "$APP_ID" ]; then
            echo "❌ APP_ID 未设置"
            exit 1
          fi

          if [ -z "$APP_SECRET" ]; then
            echo "❌ APP_SECRET 未设置"
            exit 1
          fi

          echo "✅ FEISHU_WEBHOOK 已设置"
          echo "✅ APP_ID 已设置"
          echo "✅ APP_SECRET 已设置"

      # ================================================================
      # STEP 3
      # 查找最新日报 / 周报带图版
      # ================================================================
      - name: 查找最新日报周报带图版
        id: find_reports
        shell: bash
        run: |
          set -e

          echo "=================================================="
          echo "查找最新日报 / 周报带图版"
          echo "=================================================="

          DAILY_ROOT="01_自生长知识系统/05_日报"
          WEEKLY_ROOT="01_自生长知识系统/06_周报"

          DAILY_FILE=""
          WEEKLY_FILE=""

          if [ -d "$DAILY_ROOT" ]; then
            DAILY_FILE=$(find "$DAILY_ROOT" \
              -type f \
              -name '*_带图.md' \
              | sort \
              | tail -n 1 || true)
          fi

          if [ -d "$WEEKLY_ROOT" ]; then
            WEEKLY_FILE=$(find "$WEEKLY_ROOT" \
              -type f \
              -name '*_带图.md' \
              | sort \
              | tail -n 1 || true)
          fi

          echo "日报带图版：${DAILY_FILE:-无}"
          echo "周报带图版：${WEEKLY_FILE:-无}"

          if [ -z "$DAILY_FILE" ]; then
            echo "❌ 没有找到日报带图版"
            exit 1
          fi

          echo "daily_file=$DAILY_FILE" >> "$GITHUB_OUTPUT"

          if [ -n "$WEEKLY_FILE" ]; then
            echo "weekly_file=$WEEKLY_FILE" >> "$GITHUB_OUTPUT"
            echo "weekly_exists=true" >> "$GITHUB_OUTPUT"
          else
            echo "weekly_file=" >> "$GITHUB_OUTPUT"
            echo "weekly_exists=false" >> "$GITHUB_OUTPUT"
          fi

          echo ""
          echo "✅ 日报带图版已找到"
          echo "   $DAILY_FILE"

          if [ -n "$WEEKLY_FILE" ]; then
            echo "✅ 周报带图版已找到"
            echo "   $WEEKLY_FILE"
          else
            echo "ℹ️ 没有周报带图版，本次跳过周报"
          fi

      # ================================================================
      # STEP 4
      # Python
      # ================================================================
      - name: 设置 Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # ================================================================
      # STEP 5
      # 发送日报带图版
      # ================================================================
      - name: 发送日报带图版
        shell: bash
        env:
          FEISHU_WEBHOOK: ${{ secrets.FEISHU_WEBHOOK }}
          APP_ID: ${{ secrets.APP_ID }}
          APP_SECRET: ${{ secrets.APP_SECRET }}
          REPORT_FILE: ${{ steps.find_reports.outputs.daily_file }}
        run: |
          set -e

          echo ""
          echo "=================================================="
          echo "发送日报带图版"
          echo "=================================================="
          echo "日报文件：$REPORT_FILE"

          python - <<'PY'
          import os
          import re
          import json
          import mimetypes
          import urllib.request
          import urllib.error
          import urllib.parse
          from pathlib import Path

          WEBHOOK = os.environ["FEISHU_WEBHOOK"]
          APP_ID = os.environ["APP_ID"]
          APP_SECRET = os.environ["APP_SECRET"]
          REPORT_FILE = os.environ["REPORT_FILE"]

          MAX_CHARS = 28000

          print()
          print("--------------------------------------------------")
          print("STEP 1 | 获取 tenant_access_token")
          print("--------------------------------------------------")

          token_url = (
              "https://open.feishu.cn/open-apis/"
              "auth/v3/tenant_access_token/internal"
          )

          token_payload = json.dumps({
              "app_id": APP_ID,
              "app_secret": APP_SECRET,
          }).encode("utf-8")

          token_request = urllib.request.Request(
              token_url,
              data=token_payload,
              headers={
                  "Content-Type": "application/json; charset=utf-8",
              },
              method="POST",
          )

          try:
              with urllib.request.urlopen(token_request, timeout=30) as response:
                  token_result = json.loads(
                      response.read().decode("utf-8")
                  )
          except urllib.error.HTTPError as e:
              body = e.read().decode("utf-8", errors="replace")
              print(f"❌ 获取 tenant_access_token 失败")
              print(f"HTTP {e.code}")
              print(body)
              raise

          if token_result.get("code") != 0:
              print("❌ tenant_access_token 获取失败")
              print(json.dumps(token_result, ensure_ascii=False, indent=2))
              raise RuntimeError("tenant_access_token 获取失败")

          tenant_access_token = token_result["tenant_access_token"]

          print("✅ tenant_access_token 获取成功")

          # ============================================================
          # STEP 2 | 读取 Markdown
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 2 | 读取日报 Markdown")
          print("--------------------------------------------------")

          report_path = Path(REPORT_FILE)

          if not report_path.exists():
              raise RuntimeError(
                  f"日报文件不存在：{REPORT_FILE}"
              )

          content = report_path.read_text(
              encoding="utf-8"
          )

          print(f"原始字符数：{len(content)}")

          # ============================================================
          # STEP 3 | 图片路径解析
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 3 | 上传日报图片并替换 image_key")
          print("--------------------------------------------------")

          # 当前真实仓库结构：
          #
          # 01_自生长知识系统/
          # ├── 04_图片/
          # │   └── 日报/
          # │       └── 2026-09-21/
          # │           ├── 首图.png
          # │           ├── 插图1.png
          # │           ├── 插图2.png
          # │           └── 插图3.png
          # │
          # └── 05_日报/
          #     └── 2026/
          #         └── 09/
          #             └── 2026-09-21_带图.md
          #
          # Markdown 中：
          #
          # ../04_图片/2026-09-21/首图.png
          #
          # 因此这里必须映射到：
          #
          # 01_自生长知识系统/04_图片/日报/
          # 2026-09-21/首图.png

          image_cache = {}

          image_pattern = re.compile(
              r'!\[([^\]]*)\]\(([^)]+)\)'
          )

          matches = list(image_pattern.finditer(content))

          if not matches:
              print("⚠️ Markdown 中没有发现图片")
          else:
              print(f"发现图片数量：{len(matches)}")

          def resolve_image_path(image_ref):
              image_ref = image_ref.strip()

              # 去除可能存在的 <...>
              if image_ref.startswith("<") and image_ref.endswith(">"):
                  image_ref = image_ref[1:-1].strip()

              # 当前 Markdown 图片格式：
              #
              # ../04_图片/2026-09-21/首图.png
              #
              # 实际仓库：
              #
              # 01_自生长知识系统/04_图片/日报/
              # 2026-09-21/首图.png

              marker = "04_图片/"

              if marker not in image_ref:
                  raise RuntimeError(
                      f"无法识别 Markdown 图片路径：{image_ref}"
                  )

              suffix = image_ref.split(marker, 1)[1]

              # 防止路径以 / 开头
              suffix = suffix.lstrip("/")

              actual_path = (
                  Path("01_自生长知识系统")
                  / "04_图片"
                  / "日报"
                  / suffix
              )

              return actual_path

          def get_image_key(image_path):
              cache_key = str(image_path)

              if cache_key in image_cache:
                  print("   ♻️ 使用已缓存 image_key")
                  return image_cache[cache_key]

              if not image_path.exists():
                  raise RuntimeError(
                      f"Markdown 引用的图片不存在：{image_path}"
                  )

              if not image_path.is_file():
                  raise RuntimeError(
                      f"图片路径不是文件：{image_path}"
                  )

              file_size = image_path.stat().st_size

              if file_size <= 0:
                  raise RuntimeError(
                      f"图片文件为空：{image_path}"
                  )

              print(f"   文件大小：{file_size:,} bytes")

              # --------------------------------------------------------
              # multipart/form-data
              # --------------------------------------------------------

              boundary = (
                  "----WebKitFormBoundary"
                  "748686FeishuImageUpload"
              )

              image_type_part = (
                  f"--{boundary}\r\n"
                  f'Content-Disposition: form-data; '
                  f'name="image_type"\r\n\r\n'
                  f"message\r\n"
              ).encode("utf-8")

              filename = image_path.name

              image_data = image_path.read_bytes()

              mime_type = (
                  mimetypes.guess_type(filename)[0]
                  or "image/png"
              )

              image_part_header = (
                  f"--{boundary}\r\n"
                  f'Content-Disposition: form-data; '
                  f'name="image"; filename="{filename}"\r\n'
                  f"Content-Type: {mime_type}\r\n\r\n"
              ).encode("utf-8")

              closing = (
                  f"\r\n--{boundary}--\r\n"
              ).encode("utf-8")

              body = (
                  image_type_part
                  + image_part_header
                  + image_data
                  + closing
              )

              upload_url = (
                  "https://open.feishu.cn/open-apis/im/v1/images"
              )

              upload_request = urllib.request.Request(
                  upload_url,
                  data=body,
                  headers={
                      "Authorization":
                          f"Bearer {tenant_access_token}",
                      "Content-Type":
                          f"multipart/form-data; boundary={boundary}",
                  },
                  method="POST",
              )

              try:
                  with urllib.request.urlopen(
                      upload_request,
                      timeout=120,
                  ) as response:
                      upload_result = json.loads(
                          response.read().decode("utf-8")
                      )
              except urllib.error.HTTPError as e:
                  response_body = e.read().decode(
                      "utf-8",
                      errors="replace",
                  )

                  print()
                  print("❌ 图片上传失败")
                  print(f"HTTP {e.code}")
                  print(response_body)

                  raise

              if upload_result.get("code") != 0:
                  print()
                  print("❌ 飞书图片上传失败")
                  print(
                      json.dumps(
                          upload_result,
                          ensure_ascii=False,
                          indent=2,
                      )
                  )
                  raise RuntimeError(
                      "Feishu 图片上传失败"
                  )

              image_key = (
                  upload_result
                  .get("data", {})
                  .get("image_key")
              )

              if not image_key:
                  raise RuntimeError(
                      "飞书返回成功，但没有 image_key"
                  )

              image_cache[cache_key] = image_key

              return image_key

          def replace_image(match):
              alt_text = match.group(1)
              image_ref = match.group(2).strip()

              print()
              print(f"🖼️ 图片 #{len(image_cache) + 1}")
              print(f"   Markdown：{image_ref}")

              image_path = resolve_image_path(image_ref)

              print(f"   本地文件：{image_path}")

              image_key = get_image_key(image_path)

              print(f"   image_key：{image_key}")

              # Feishu interactive card Markdown
              # 使用 image_key 替换原图片路径
              return f"![{alt_text}]({image_key})"

          content_with_keys = image_pattern.sub(
              replace_image,
              content,
          )

          print()
          print("--------------------------------------------------")
          print("图片上传完成")
          print("--------------------------------------------------")

          print(f"成功上传图片：{len(image_cache)} 张")

          # ============================================================
          # STEP 4 | 分段
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 4 | 处理 Markdown 内容")
          print("--------------------------------------------------")

          def split_content(text, max_chars=MAX_CHARS):
              if len(text) <= max_chars:
                  return [text]

              chunks = []

              while len(text) > max_chars:
                  cut = text.rfind("\n", 0, max_chars)

                  if cut <= 0:
                      cut = max_chars

                  chunks.append(text[:cut])
                  text = text[cut:].lstrip("\n")

              if text:
                  chunks.append(text)

              return chunks

          chunks = split_content(content_with_keys)

          print(f"发送分段数量：{len(chunks)}")

          # ============================================================
          # STEP 5 | 发送 Feishu interactive card
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 5 | 发送飞书 interactive card")
          print("--------------------------------------------------")

          title = (
              report_path.stem
              .replace("_带图", "")
          )

          for index, chunk in enumerate(chunks, start=1):

              if len(chunks) == 1:
                  card_title = f"{title} · 带图版"
              else:
                  card_title = (
                      f"{title} · 带图版 "
                      f"({index}/{len(chunks)})"
                  )

              payload = {
                  "msg_type": "interactive",
                  "card": {
                      "header": {
                          "title": {
                              "tag": "plain_text",
                              "content": card_title,
                          },
                          "template": "blue",
                      },
                      "elements": [
                          {
                              "tag": "markdown",
                              "content": chunk,
                          }
                      ],
                  },
              }

              request_body = json.dumps(
                  payload,
                  ensure_ascii=False,
              ).encode("utf-8")

              webhook_request = urllib.request.Request(
                  WEBHOOK,
                  data=request_body,
                  headers={
                      "Content-Type":
                          "application/json; charset=utf-8",
                  },
                  method="POST",
              )

              try:
                  with urllib.request.urlopen(
                      webhook_request,
                      timeout=60,
                  ) as response:
                      response_text = (
                          response.read()
                          .decode("utf-8")
                      )

                      response_json = json.loads(
                          response_text
                      )

              except urllib.error.HTTPError as e:
                  body = e.read().decode(
                      "utf-8",
                      errors="replace",
                  )

                  print()
                  print("❌ 飞书 Webhook HTTP 错误")
                  print(f"HTTP {e.code}")
                  print(body)

                  raise

              print()
              print(
                  f"第 {index}/{len(chunks)} 段返回："
                  f"{response_text}"
              )

              if response_json.get("code") != 0:
                  print()
                  print("❌ 飞书消息发送失败")
                  print(
                      json.dumps(
                          response_json,
                          ensure_ascii=False,
                          indent=2,
                      )
                  )
                  raise RuntimeError(
                      "Feishu Webhook 返回非 0"
                  )

          print()
          print("==================================================")
          print("✅ 日报带图版发送成功")
          print("==================================================")
          PY

      # ================================================================
      # STEP 6
      # 发送周报带图版
      #
      # 周报是可选：
      # 没有周报 → SKIP
      # 没有 *_带图.md → SKIP
      # 不允许因为周报不存在导致 Workflow 失败
      # ================================================================
      - name: 发送周报带图版
        if: steps.find_reports.outputs.weekly_exists == 'true'
        shell: bash
        env:
          FEISHU_WEBHOOK: ${{ secrets.FEISHU_WEBHOOK }}
          APP_ID: ${{ secrets.APP_ID }}
          APP_SECRET: ${{ secrets.APP_SECRET }}
          REPORT_FILE: ${{ steps.find_reports.outputs.weekly_file }}
        run: |
          set -e

          echo ""
          echo "=================================================="
          echo "发送周报带图版"
          echo "=================================================="
          echo "周报文件：$REPORT_FILE"

          python - <<'PY'
          import os
          import re
          import json
          import mimetypes
          import urllib.request
          import urllib.error
          from pathlib import Path

          WEBHOOK = os.environ["FEISHU_WEBHOOK"]
          APP_ID = os.environ["APP_ID"]
          APP_SECRET = os.environ["APP_SECRET"]
          REPORT_FILE = os.environ["REPORT_FILE"]

          MAX_CHARS = 28000

          print()
          print("--------------------------------------------------")
          print("STEP 1 | 获取 tenant_access_token")
          print("--------------------------------------------------")

          token_url = (
              "https://open.feishu.cn/open-apis/"
              "auth/v3/tenant_access_token/internal"
          )

          token_payload = json.dumps({
              "app_id": APP_ID,
              "app_secret": APP_SECRET,
          }).encode("utf-8")

          token_request = urllib.request.Request(
              token_url,
              data=token_payload,
              headers={
                  "Content-Type": "application/json; charset=utf-8",
              },
              method="POST",
          )

          try:
              with urllib.request.urlopen(
                  token_request,
                  timeout=30,
              ) as response:
                  token_result = json.loads(
                      response.read().decode("utf-8")
                  )
          except urllib.error.HTTPError as e:
              body = e.read().decode(
                  "utf-8",
                  errors="replace",
              )

              print("❌ 获取 tenant_access_token 失败")
              print(f"HTTP {e.code}")
              print(body)

              raise

          if token_result.get("code") != 0:
              print("❌ tenant_access_token 获取失败")
              print(
                  json.dumps(
                      token_result,
                      ensure_ascii=False,
                      indent=2,
                  )
              )
              raise RuntimeError(
                  "tenant_access_token 获取失败"
              )

          tenant_access_token = token_result[
              "tenant_access_token"
          ]

          print("✅ tenant_access_token 获取成功")

          # ============================================================
          # STEP 2 | 读取周报 Markdown
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 2 | 读取周报 Markdown")
          print("--------------------------------------------------")

          report_path = Path(REPORT_FILE)

          if not report_path.exists():
              raise RuntimeError(
                  f"周报文件不存在：{REPORT_FILE}"
              )

          content = report_path.read_text(
              encoding="utf-8"
          )

          print(f"原始字符数：{len(content)}")

          # ============================================================
          # STEP 3 | 上传图片
          #
          # 真实周报图片结构：
          #
          # 01_自生长知识系统/
          # └── 04_图片/
          #     └── 周报/
          #         └── YYYY-MM-DD/
          #
          # 如果当前周报 Markdown 中的图片引用仍采用：
          #
          # ../04_图片/YYYY-MM-DD/xxx.png
          #
          # 就映射到：
          #
          # 01_自生长知识系统/04_图片/周报/YYYY-MM-DD/xxx.png
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 3 | 上传周报图片并替换 image_key")
          print("--------------------------------------------------")

          image_cache = {}

          image_pattern = re.compile(
              r'!\[([^\]]*)\]\(([^)]+)\)'
          )

          matches = list(
              image_pattern.finditer(content)
          )

          if not matches:
              print("⚠️ 周报 Markdown 中没有发现图片")
          else:
              print(f"发现图片数量：{len(matches)}")

          def resolve_image_path(image_ref):
              image_ref = image_ref.strip()

              if (
                  image_ref.startswith("<")
                  and image_ref.endswith(">")
              ):
                  image_ref = image_ref[1:-1].strip()

              marker = "04_图片/"

              if marker not in image_ref:
                  raise RuntimeError(
                      f"无法识别 Markdown 图片路径："
                      f"{image_ref}"
                  )

              suffix = image_ref.split(
                  marker,
                  1,
              )[1]

              suffix = suffix.lstrip("/")

              actual_path = (
                  Path("01_自生长知识系统")
                  / "04_图片"
                  / "周报"
                  / suffix
              )

              return actual_path

          def get_image_key(image_path):

              cache_key = str(image_path)

              if cache_key in image_cache:
                  print("   ♻️ 使用已缓存 image_key")
                  return image_cache[cache_key]

              if not image_path.exists():
                  raise RuntimeError(
                      f"Markdown 引用的图片不存在："
                      f"{image_path}"
                  )

              if not image_path.is_file():
                  raise RuntimeError(
                      f"图片路径不是文件：{image_path}"
                  )

              file_size = image_path.stat().st_size

              if file_size <= 0:
                  raise RuntimeError(
                      f"图片文件为空：{image_path}"
                  )

              print(
                  f"   文件大小："
                  f"{file_size:,} bytes"
              )

              boundary = (
                  "----WebKitFormBoundary"
                  "748686FeishuWeeklyImage"
              )

              image_type_part = (
                  f"--{boundary}\r\n"
                  f'Content-Disposition: form-data; '
                  f'name="image_type"\r\n\r\n'
                  f"message\r\n"
              ).encode("utf-8")

              filename = image_path.name

              image_data = image_path.read_bytes()

              mime_type = (
                  mimetypes.guess_type(filename)[0]
                  or "image/png"
              )

              image_part_header = (
                  f"--{boundary}\r\n"
                  f'Content-Disposition: form-data; '
                  f'name="image"; '
                  f'filename="{filename}"\r\n'
                  f"Content-Type: {mime_type}\r\n\r\n"
              ).encode("utf-8")

              closing = (
                  f"\r\n--{boundary}--\r\n"
              ).encode("utf-8")

              body = (
                  image_type_part
                  + image_part_header
                  + image_data
                  + closing
              )

              upload_url = (
                  "https://open.feishu.cn/open-apis/"
                  "im/v1/images"
              )

              upload_request = urllib.request.Request(
                  upload_url,
                  data=body,
                  headers={
                      "Authorization":
                          f"Bearer {tenant_access_token}",
                      "Content-Type":
                          f"multipart/form-data; "
                          f"boundary={boundary}",
                  },
                  method="POST",
              )

              try:
                  with urllib.request.urlopen(
                      upload_request,
                      timeout=120,
                  ) as response:
                      upload_result = json.loads(
                          response.read().decode("utf-8")
                      )

              except urllib.error.HTTPError as e:
                  response_body = e.read().decode(
                      "utf-8",
                      errors="replace",
                  )

                  print()
                  print("❌ 图片上传失败")
                  print(f"HTTP {e.code}")
                  print(response_body)

                  raise

              if upload_result.get("code") != 0:
                  print()
                  print("❌ 飞书图片上传失败")
                  print(
                      json.dumps(
                          upload_result,
                          ensure_ascii=False,
                          indent=2,
                      )
                  )
                  raise RuntimeError(
                      "Feishu 图片上传失败"
                  )

              image_key = (
                  upload_result
                  .get("data", {})
                  .get("image_key")
              )

              if not image_key:
                  raise RuntimeError(
                      "飞书返回成功，但没有 image_key"
                  )

              image_cache[cache_key] = image_key

              return image_key

          def replace_image(match):
              alt_text = match.group(1)
              image_ref = match.group(2).strip()

              print()
              print(
                  f"🖼️ 图片 #{len(image_cache) + 1}"
              )
              print(f"   Markdown：{image_ref}")

              image_path = resolve_image_path(
                  image_ref
              )

              print(
                  f"   本地文件：{image_path}"
              )

              image_key = get_image_key(
                  image_path
              )

              print(
                  f"   image_key：{image_key}"
              )

              return (
                  f"![{alt_text}]({image_key})"
              )

          content_with_keys = image_pattern.sub(
              replace_image,
              content,
          )

          print()
          print("--------------------------------------------------")
          print("周报图片上传完成")
          print("--------------------------------------------------")

          print(
              f"成功上传图片："
              f"{len(image_cache)} 张"
          )

          # ============================================================
          # STEP 4 | 分段
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 4 | 处理 Markdown 内容")
          print("--------------------------------------------------")

          def split_content(
              text,
              max_chars=MAX_CHARS,
          ):
              if len(text) <= max_chars:
                  return [text]

              chunks = []

              while len(text) > max_chars:
                  cut = text.rfind(
                      "\n",
                      0,
                      max_chars,
                  )

                  if cut <= 0:
                      cut = max_chars

                  chunks.append(text[:cut])

                  text = text[
                      cut:
                  ].lstrip("\n")

              if text:
                  chunks.append(text)

              return chunks

          chunks = split_content(
              content_with_keys
          )

          print(
              f"发送分段数量："
              f"{len(chunks)}"
          )

          # ============================================================
          # STEP 5 | 发送飞书
          # ============================================================

          print()
          print("--------------------------------------------------")
          print("STEP 5 | 发送飞书 interactive card")
          print("--------------------------------------------------")

          title = (
              report_path.stem
              .replace("_带图", "")
          )

          for index, chunk in enumerate(
              chunks,
              start=1,
          ):

              if len(chunks) == 1:
                  card_title = (
                      f"{title} · 带图版"
                  )
              else:
                  card_title = (
                      f"{title} · 带图版 "
                      f"({index}/{len(chunks)})"
                  )

              payload = {
                  "msg_type": "interactive",
                  "card": {
                      "header": {
                          "title": {
                              "tag": "plain_text",
                              "content": card_title,
                          },
                          "template": "green",
                      },
                      "elements": [
                          {
                              "tag": "markdown",
                              "content": chunk,
                          }
                      ],
                  },
              }

              request_body = json.dumps(
                  payload,
                  ensure_ascii=False,
              ).encode("utf-8")

              webhook_request = urllib.request.Request(
                  WEBHOOK,
                  data=request_body,
                  headers={
                      "Content-Type":
                          "application/json; charset=utf-8",
                  },
                  method="POST",
              )

              try:
                  with urllib.request.urlopen(
                      webhook_request,
                      timeout=60,
                  ) as response:

                      response_text = (
                          response.read()
                          .decode("utf-8")
                      )

                      response_json = json.loads(
                          response_text
                      )

              except urllib.error.HTTPError as e:

                  body = e.read().decode(
                      "utf-8",
                      errors="replace",
                  )

                  print()
                  print(
                      "❌ 飞书 Webhook HTTP 错误"
                  )
                  print(f"HTTP {e.code}")
                  print(body)

                  raise

              print()
              print(
                  f"第 {index}/{len(chunks)} 段返回："
                  f"{response_text}"
              )

              if response_json.get("code") != 0:
                  print()
                  print(
                      "❌ 飞书消息发送失败"
                  )

                  print(
                      json.dumps(
                          response_json,
                          ensure_ascii=False,
                          indent=2,
                      )
                  )

                  raise RuntimeError(
                      "Feishu Webhook 返回非 0"
                  )

          print()
          print("==================================================")
          print("✅ 周报带图版发送成功")
          print("==================================================")
          PY

      # ================================================================
      # STEP 7
      # 最终结果
      # ================================================================
      - name: 最终结果
        if: always()
        shell: bash
        env:
          WEEKLY_EXISTS: ${{ steps.find_reports.outputs.weekly_exists }}
        run: |
          echo ""
          echo "=================================================="
          echo "飞书日报周报带图版测试完成"
          echo "=================================================="
          echo "日报：已执行"
          
          if [ "$WEEKLY_EXISTS" = "true" ]; then
            echo "周报：已执行"
          else
            echo "周报：SKIP（没有周报带图版）"
          fi

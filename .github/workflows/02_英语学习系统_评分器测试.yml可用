name: 02_英语学习系统 - Grader V1.0 测试

on:
  workflow_dispatch:

    inputs:

      # =========================================================
      # 选择考试日期
      # =========================================================

      exam_date:
        description: "选择要解析和测试的考试日期，例如 2026-09-28"
        required: true
        default: "2026-09-28"
        type: string

permissions:
  contents: read

jobs:
  grader-test:
    name: English Exam Grader V1.0 FULL TEST
    runs-on: ubuntu-latest

    steps:

      # =========================================================
      # 1. Checkout
      # =========================================================

      - name: Checkout repository
        uses: actions/checkout@v4

      # =========================================================
      # 2. Python
      # =========================================================

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # =========================================================
      # 3. 确定选择的考试日期
      # =========================================================

      - name: Determine selected exam date
        id: dates
        shell: bash
        run: |
          set -e

          DATE="${{ inputs.exam_date }}"

          echo "============================================================"
          echo "748686 ENGLISH LEARNING SYSTEM"
          echo "GRADER V1.0 TEST"
          echo "============================================================"
          echo
          echo "选择的考试日期:"
          echo "  $DATE"
          echo

          # -------------------------------------------------------
          # 日期格式检查
          # -------------------------------------------------------

          if ! [[ "$DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            echo
            echo "❌ 日期格式错误"
            echo
            echo "正确格式:"
            echo "  YYYY-MM-DD"
            echo
            echo "例如:"
            echo "  2026-09-28"
            exit 1
          fi

          echo "date=$DATE" >> "$GITHUB_OUTPUT"

      # =========================================================
      # 4. 检查 Parser / Grader / Test 文件
      # =========================================================

      - name: Check Grader files
        shell: bash
        run: |
          set -e

          echo
          echo "============================================================"
          echo "CHECK GRADER FILES"
          echo "============================================================"

          PARSER="02_英语学习系统/scripts/english_exam_parser.py"
          GRADER="02_英语学习系统/scripts/english_exam_grader.py"
          TEST="02_英语学习系统/scripts/test_english_exam_grader_v1_0.py"

          if [ ! -f "$PARSER" ]; then
            echo "❌ 未找到: $PARSER"
            exit 1
          fi

          if [ ! -f "$GRADER" ]; then
            echo "❌ 未找到: $GRADER"
            exit 1
          fi

          if [ ! -f "$TEST" ]; then
            echo "❌ 未找到: $TEST"
            exit 1
          fi

          echo
          echo "✅ english_exam_parser.py"
          echo "✅ english_exam_grader.py"
          echo "✅ test_english_exam_grader_v1_0.py"

      # =========================================================
      # 5. 根据选择的日期寻找真实考试 Markdown
      #
      # 用户选择：
      #   2026-09-28
      #
      # 自动读取：
      #
      # 02_英语学习系统/output/2026-09-28/配套试卷/
      #
      #   *_试卷.md
      #   *_答案与解析.md
      #
      # =========================================================

      - name: Locate real exam Markdown
        id: locate_exam
        env:
          EXAM_DATE: ${{ steps.dates.outputs.date }}
        shell: bash
        run: |
          set -e

          echo
          echo "============================================================"
          echo "LOCATE REAL EXAM MARKDOWN"
          echo "============================================================"

          DATE="$EXAM_DATE"

          DIR="02_英语学习系统/output/$DATE/配套试卷"

          echo
          echo "选择日期:"
          echo "  $DATE"
          echo
          echo "检查目录:"
          echo "  $DIR"
          echo

          # -------------------------------------------------------
          # 检查目录
          # -------------------------------------------------------

          if [ ! -d "$DIR" ]; then

            echo "❌ 配套试卷目录不存在"
            echo
            echo "期望目录:"
            echo "  $DIR"
            echo
            echo "当前已有 output 日期目录:"

            if [ -d "02_英语学习系统/output" ]; then

              find "02_英语学习系统/output" \
                -maxdepth 1 \
                -mindepth 1 \
                -type d \
                | sort

            else

              echo "  output 目录不存在"

            fi

            exit 1
          fi

          # -------------------------------------------------------
          # 找真实试卷
          # -------------------------------------------------------

          CANDIDATE="$(find "$DIR" \
            -maxdepth 1 \
            -type f \
            -name "*_试卷.md" \
            | sort \
            | head -n 1)"

          if [ -z "$CANDIDATE" ]; then

            echo
            echo "❌ 未找到 *_试卷.md"
            echo
            echo "检查目录:"
            echo "  $DIR"
            echo
            echo "目录实际内容:"
            ls -lah "$DIR"

            exit 1
          fi

          # -------------------------------------------------------
          # 根据试卷文件名寻找对应答案与解析
          #
          # 例如：
          #
          # 1星_议论文_试卷.md
          #
          # 对应：
          #
          # 1星_议论文_答案与解析.md
          # -------------------------------------------------------

          BASENAME="$(basename "$CANDIDATE" "_试卷.md")"

          CANDIDATE_ANSWERS="$DIR/${BASENAME}_答案与解析.md"

          echo
          echo "发现试卷:"
          echo "  $CANDIDATE"

          echo
          echo "寻找答案与解析:"
          echo "  $CANDIDATE_ANSWERS"

          if [ ! -f "$CANDIDATE_ANSWERS" ]; then

            echo
            echo "❌ 对应答案与解析不存在"
            echo
            echo "期望文件:"
            echo "  $CANDIDATE_ANSWERS"
            echo
            echo "目录实际内容:"
            ls -lah "$DIR"

            exit 1
          fi

          # -------------------------------------------------------
          # 最终确认
          # -------------------------------------------------------

          echo
          echo "============================================================"
          echo "✅ FOUND REAL EXAM"
          echo "============================================================"
          echo
          echo "考试日期:"
          echo "  $DATE"
          echo
          echo "试卷:"
          echo "  $CANDIDATE"
          echo
          echo "答案与解析:"
          echo "  $CANDIDATE_ANSWERS"

          echo "date=$DATE" >> "$GITHUB_OUTPUT"
          echo "exam=$CANDIDATE" >> "$GITHUB_OUTPUT"
          echo "answers=$CANDIDATE_ANSWERS" >> "$GITHUB_OUTPUT"

      # =========================================================
      # 6. Parser V1.6.2
      #
      # 将真实 Markdown 临时转换成 exam.json
      #
      # 注意：
      # 这个 JSON 只存在于 GitHub Actions runner 的 /tmp
      # 不写回仓库
      # =========================================================

      - name: Run Parser V1.6.2 and create temporary exam JSON
        env:
          EXAM: ${{ steps.locate_exam.outputs.exam }}
          ANSWERS: ${{ steps.locate_exam.outputs.answers }}
        shell: bash
        run: |
          set -e

          echo
          echo "============================================================"
          echo "RUN ENGLISH EXAM PARSER V1.6.2"
          echo "============================================================"
          echo
          echo "真实试卷:"
          echo "  $EXAM"
          echo
          echo "答案与解析:"
          echo "  $ANSWERS"
          echo

          JSON="/tmp/748686_exam_parser_v1_6.json"

          rm -f "$JSON"

          python \
            "02_英语学习系统/scripts/english_exam_parser.py" \
            --exam "$EXAM" \
            --answers "$ANSWERS" \
            --output "$JSON" \
            --validate

          if [ ! -s "$JSON" ]; then
            echo
            echo "❌ Parser V1.6.2 没有生成有效 JSON"
            exit 1
          fi

          echo
          echo "============================================================"
          echo "✅ PARSER V1.6.2 PASSED"
          echo "============================================================"
          echo
          echo "临时 JSON:"
          echo "  $JSON"
          echo
          echo "Parser V1.6.2 已成功将真实试卷转换为 Grader 输入。"

      # =========================================================
      # 7. 验证 Parser 生成的临时 JSON
      # =========================================================

      - name: Validate parsed exam JSON
        shell: bash
        run: |
          set -e

          JSON="/tmp/748686_exam_parser_v1_6.json"

          echo
          echo "============================================================"
          echo "VALIDATE PARSED EXAM JSON"
          echo "============================================================"

          if [ ! -s "$JSON" ]; then
            echo "❌ JSON 不存在或为空"
            exit 1
          fi

          VERSION="$(python -c '
          import json
          import sys

          path = sys.argv[1]

          with open(path, "r", encoding="utf-8") as f:
              data = json.load(f)

          print(data.get("version", ""))
          ' "$JSON")"

          echo
          echo "Parser JSON version:"
          echo "  $VERSION"

          if [ "$VERSION" != "1.6.2" ]; then
            echo
            echo "❌ Parser JSON version 不是 1.6.2"
            exit 1
          fi

          TOTAL="$(python -c '
          import json
          import sys

          path = sys.argv[1]

          with open(path, "r", encoding="utf-8") as f:
              data = json.load(f)

          questions = data.get("questions")

          if not isinstance(questions, list):
              raise SystemExit("questions 不是数组")

          print(len(questions))
          ' "$JSON")"

          echo
          echo "Parser 输出题目数量:"
          echo "  $TOTAL"

          if [ "$TOTAL" -ne 61 ]; then
            echo
            echo "❌ Parser 输出不是 61 道题"
            exit 1
          fi

          echo
          echo "✅ Parser V1.6.2 version = 1.6.2"
          echo "✅ Parser V1.6.2 输出 61 道题"
          echo "✅ 临时 exam.json 结构正常"

      # =========================================================
      # 8. DEBUG | 检查 Parser 输出中的听力结构
      # =========================================================

      - name: DEBUG listening questions in parsed JSON
        shell: bash
        run: |
          set -e

          JSON="/tmp/748686_exam_parser_v1_6.json"

          echo
          echo "============================================================"
          echo "DEBUG PARSED LISTENING QUESTIONS"
          echo "============================================================"

          python - "$JSON" <<'PY'
          import json
          import sys

          path = sys.argv[1]

          with open(path, "r", encoding="utf-8") as f:
              data = json.load(f)

          questions = data.get("questions", [])

          print()
          print("JSON version:")
          print(" ", data.get("version"))

          print()
          print("总题数:")
          print(" ", len(questions))

          print()
          print("各 section 数量:")
          counts = {}

          for q in questions:
              section = q.get("section")
              counts[section] = counts.get(section, 0) + 1

          for section, count in counts.items():
              print(f"  {section}: {count}")

          print()
          print("============================================================")
          print("LISTENING QUESTIONS")
          print("============================================================")

          listening = [
              q for q in questions
              if q.get("section") == "listening"
          ]

          print()
          print("listening 数量:")
          print(" ", len(listening))

          for i, q in enumerate(listening, 1):
              print()
              print(f"[{i}]")
              print("  id     :", q.get("id"))
              print("  section:", q.get("section"))
              print("  part   :", q.get("part"))
              print("  number :", q.get("number"))
              print("  answer :", q.get("answer"))
              print("  question:", repr(q.get("question", ""))[:300])

          print()
          print("============================================================")
          print("FIRST 25 QUESTIONS")
          print("============================================================")

          for i, q in enumerate(questions[:25], 1):
              print(
                  f"{i:02d}. "
                  f"id={q.get('id')} | "
                  f"section={q.get('section')} | "
                  f"part={q.get('part')} | "
                  f"number={q.get('number')}"
              )

          print()
          print("============================================================")
          print("DEBUG COMPLETE")
          print("============================================================")
          PY

      # =========================================================
      # 9. Grader V1.0 完整自动测试
      # =========================================================

      - name: Run Grader V1.0 FULL TEST
        shell: bash
        run: |
          set -e

          EXAM_JSON="/tmp/748686_exam_parser_v1_6.json"

          echo
          echo "============================================================"
          echo "RUN ENGLISH EXAM GRADER V1.0 FULL TEST"
          echo "============================================================"
          echo
          echo "考试 JSON:"
          echo "  $EXAM_JSON"
          echo
          echo "测试脚本:"
          echo "  02_英语学习系统/scripts/test_english_exam_grader_v1_0.py"
          echo

          python \
            "02_英语学习系统/scripts/test_english_exam_grader_v1_0.py" \
            --exam-json "$EXAM_JSON"

      # =========================================================
      # 10. 最终确认
      # =========================================================

      - name: Final Test Summary
        shell: bash
        run: |
          echo
          echo "============================================================"
          echo "🎉 GRADER V1.0 FULL TEST PASSED"
          echo "============================================================"
          echo
          echo "本次选择考试日期:"
          echo "  ${{ steps.dates.outputs.date }}"
          echo
          echo "真实数据链:"
          echo "  真实考试 Markdown"
          echo "        ↓"
          echo "  Parser V1.6.2"
          echo "        ↓"
          echo "  临时 exam.json"
          echo "        ↓"
          echo "  Grader V1.0"
          echo
          echo "已验证:"
          echo "  ✅ Parser JSON version = 1.6.2"
          echo "  ✅ 61 道题结构"
          echo "  ✅ 50 道自动评分题"
          echo "  ✅ 11 道人工/语义处理题"
          echo "  ✅ 50/50 全部正确"
          echo "  ✅ 单选评分"
          echo "  ✅ 多选集合匹配"
          echo "  ✅ 完形评分"
          echo "  ✅ 阅读评分"
          echo "  ✅ 听力评分"
          echo "  ✅ 故意错误识别"
          echo "  ✅ 错题回顾"
          echo "  ✅ 翻译人工复核"
          echo "  ✅ 写作人工复核"
          echo "  ✅ 提交结果卡"
          echo
          echo "Parser V1.6.2：正常"
          echo "Grader V1.0：未修改"
          echo "测试脚本：V1.0"
          echo
          echo "临时 exam.json：仅用于本次 Actions 测试，不写入仓库"
          echo
          echo "============================================================"

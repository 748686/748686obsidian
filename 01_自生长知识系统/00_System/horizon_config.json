{
  "ai": {
  "provider": "openai",
  "model": "agnes-2.5-flash",
  "base_url": "https://api.agnes-ai.cn/v1",
  "api_key_env": "AGNES_API_KEY",
  "temperature": 0.3,
  "max_tokens": 8192,
  "throttle_sec": 1,
  "languages": [
    "zh",
    "en"
  ],
  "analysis_concurrency": 5,
  "enrichment_concurrency": 5
},
  "sources": {
    "rss": []
  },
  "collection": {
    "time_window_hours": 24
  },
 "processing": {
  "profiles_dir": "${HORIZON_PROFILES_DIR}",
  "default_profile": "tech-news"
},
  "digest": {
    "max_items": 20
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "platform": "feishu",
    "layout": "collapsible",
    "languages": [
      "zh"
    ]
  }
}
